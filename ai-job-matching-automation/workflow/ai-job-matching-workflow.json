        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  model: \"nvidia/nemotron-3.5-lightning-30b-a3b\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a professional resume analysis assistant. Extract accurate information from the provided resume. Do not invent or guess information. Return only valid JSON.\"\n    },\n    {\n      role: \"user\",\n      content: \"Analyze this resume and extract the candidate profile.\\n\\nResume:\\n\" + $('Extract from File').item.json.text + \"\\n\\nReturn ONLY valid JSON with these fields:\\nname, email, phone, location, education, degree, university, gpa, skills, programming_languages, frameworks, databases, cloud_technologies, tools, projects, experience, certifications, preferred_roles, experience_level.\\n\\nUse empty strings when text information is unavailable and empty arrays when list information is unavailable.\"\n    }\n  ],\n  temperature: 0.2,\n  top_p: 0.95,\n  max_tokens: 4000,\n  stream: false,\n  chat_template_kwargs: {\n    enable_thinking: false\n  }\n}\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
