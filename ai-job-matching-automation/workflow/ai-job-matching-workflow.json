      "name": "ITPro - Parse RSS"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst jobs = data.rss?.channel?.item || [];\n\nreturn jobs.map(job => {\n  return {\n    json: {\n      title: job.title || \"\",\n      company: \"\",\n      location: \"\",\n      job_type: \"\",\n      experience_level: \"\",\n      description: job.description || \"\",\n      requirements: \"\",\n      source: \"ITPro.lk\",\n      url: job.link || \"\",\n      posted_date: job.pubDate || \"\",\n      collected_at: new Date().toISOString(),\n      deadline: \"\",\n      status: \"new\",\n      match_score: \"\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -32
      ],
      "id": "7fe52df9-54d9-4c1c-a8b2-a8632828a88a",
      "name": "Extract ITPro Jobs",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "jobs",
              "cssSelector": "div.base-search-card",
              "returnArray": true
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        400,
        -208
      ],
      "id": "fe83b89e-d813-4f04-811f-51d0ca690151",
      "name": "HTML"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $input.first().json.jobs || [];\n\nreturn jobs.map(job => {\n  const text = job\n    .replace(/\\n+/g, '\\n')\n    .trim();\n\n  const urlMatch = text.match(\n    /https?:\\/\\/(?:[a-z]{2,3}\\.)?linkedin\\.com\\/jobs\\/view\\/[^\\s]+/i\n  );\n\n  const url = urlMatch ? urlMatch[0] : '';\n\n  const lines = text\n    .split('\\n')\n    .map(line => line.trim())\n    .filter(Boolean);\n\n  const title = lines[0] || '';\n\n  const postedDateMatch = text.match(\n    /(?:just now|\\d+\\s+(?:minute|hour|day|week|month|year)s?\\s+ago)/i\n  );\n\n  return {\n    json: {\n      title: title,\n      company: \"\",\n      location: \"\",\n      job_type: \"\",\n      experience_level: \"\",\n      description: text,\n      requirements: \"\",\n      source: \"LinkedIn\",\n      url: url,\n      posted_date: postedDateMatch ? postedDateMatch[0] : \"\",\n      collected_at: new Date().toISOString(),\n      deadline: \"\",\n      status: \"new\",\n      match_score: \"\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -208
      ],
      "id": "22a14c71-1e1d-4b1f-9418-6e3334e144d3",
      "name": "Extract Jobs"
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        752,
        -128
      ],
      "id": "507c40c7-e345-47f8-9c6c-8172d81018de",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $input.all();\n\nconst seen = new Set();\nconst uniqueJobs = [];\n\nfor (const item of jobs) {\n  const job = item.json;\n\n  const key = (\n    (job.title || '') + '|' +\n    (job.company || '') + '|' +\n    (job.location || '')\n  )\n    .toLowerCase()\n    .trim();\n\n  if (!seen.has(key)) {\n    seen.add(key);\n    uniqueJobs.push(item);\n  }\n}\n\nreturn uniqueJobs;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        -128
      ],
      "id": "481d15cb-e20e-41b2-9ade-b269a2b046e3",
      "name": "Remove Duplicates"
    },
    {
      "parameters": {
        "jsCode": "const jobs = $input.all();\n\nreturn jobs.map(item => {\n  const job = item.json;\n\n  const base = `${job.source}-${job.title}-${job.company}-${job.url}`;\n\n  let hash = 0;\n  for (let i = 0; i < base.length; i++) {\n    hash = ((hash << 5) - hash) + base.charCodeAt(i);\n    hash |= 0;\n  }\n\n  return {\n    json: {\n      job_id: `${job.source}-${Math.abs(hash)}`,\n      ...job\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        -128
      ],
      "id": "1b68738b-d00d-4d7a-8825-0ddaf4976777",
