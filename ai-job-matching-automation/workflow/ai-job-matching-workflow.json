    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI job-matching assistant for LankaJob Intelligence.\n\nAnalyze the following job against my profile.\n\nJOB:\nTitle: {{ $('Prepare Jobs').item.json.title }}\nCompany: {{ $('Prepare Jobs').item.json.company }}\nLocation: {{ $('Prepare Jobs').item.json.location }}\nJob Type: {{ $('Prepare Jobs').item.json.job_type }}\nExperience Level: {{ $('Prepare Jobs').item.json.experience_level }}\nDescription: {{ $('Prepare Jobs').item.json.description }}\nRequirements: {{ $('Prepare Jobs').item.json.requirements }}\nSource: {{ $('Prepare Jobs').item.json.source }}\nURL: {{ $('Prepare Jobs').item.json.url }}\nMatch Score: {{ $json.match_score }}\n\nMY PROFILE:\n{{ JSON.stringify($('Get My Profile').first().json) }}\n\nTASK:\nEvaluate how relevant this job is for me.\n\nConsider:\n1. How well my technical skills match the job.\n2. Whether my education and experience are suitable.\n3. Whether this is appropriate for my experience level.\n4. Which of my skills match the job.\n5. Which important skills or requirements I am missing.\n6. Whether I should apply.\n\nReturn ONLY valid JSON in this exact structure:\n\n{\n  \"job_relevance\": \"High\",\n  \"why_match\": \"Brief explanation\",\n  \"matching_skills\": [\"skill1\", \"skill2\"],\n  \"missing_skills\": [\"skill1\", \"skill2\"],\n  \"recommendation\": \"Apply\"\n}\n\nUse only information provided in the job and profile. Do not invent skills, experience, qualifications, or requirements.",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 5
        }
