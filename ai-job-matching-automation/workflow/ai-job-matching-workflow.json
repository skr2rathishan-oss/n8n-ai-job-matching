    {
      "parameters": {
        "jsCode": "const profile = $input.first().json;\nconst jobs = $('Append row in sheet').all();\n\nfunction text(value) {\n  if (Array.isArray(value)) {\n    return value.map(v =>\n      typeof v === 'object' ? Object.values(v).join(' ') : String(v)\n    ).join(' ');\n  }\n\n  if (value === null || value === undefined) return '';\n  return String(value);\n}\n\nfunction normalize(value) {\n  return text(value)\n    .toLowerCase()\n    .replace(/[^\\w+#.\\- ]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n// --------------------------------------------------\n// YOUR PROFILE\n// --------------------------------------------------\n\nconst profileSkills = normalize([\n  profile.skills,\n  profile.programming_languages,\n  profile.frameworks,\n  profile.databases,\n  profile.cloud_technologies,\n  profile.tools\n].join(' '));\n\nconst profileRoles = normalize(profile.preferred_roles);\nconst profileExperience = normalize(profile.experience);\nconst profileEducation = normalize([\n  profile.education,\n  profile.degree\n].join(' '));\n\n// --------------------------------------------------\n// RELATED TECHNOLOGY GROUPS\n// --------------------------------------------------\n\nconst relatedGroups = [\n  ['javascript', 'typescript', 'node.js', 'nodejs'],\n  ['react', 'react.js', 'next.js', 'frontend', 'front-end'],\n  ['node.js', 'nodejs', 'express.js', 'express', 'backend', 'back-end'],\n  ['mongodb', 'mongoose', 'nosql'],\n  ['sql', 'mysql', 'postgresql', 'postgres', 'database'],\n  ['azure', 'microsoft azure', 'cloud'],\n  ['docker', 'container', 'containers'],\n  ['github actions', 'ci/cd', 'cicd', 'continuous integration'],\n  ['html', 'css', 'html5', 'css3', 'web development'],\n  ['rest api', 'restful api', 'api development'],\n  ['c++', 'cpp'],\n  ['python', 'machine learning', 'data science'],\n  ['git', 'github', 'version control'],\n  ['agile', 'scrum'],\n  ['react', 'frontend', 'web development'],\n  ['node.js', 'backend', 'api development']\n];\n\nfunction getGroup(word) {\n  for (const group of relatedGroups) {\n    if (group.includes(word)) {\n      return group;\n    }\n  }\n\n  return null;\n}\n\n// --------------------------------------------------\n// CHECK WHETHER A SKILL MATCHES\n// --------------------------------------------------\n\nfunction skillMatch(requiredSkill, profileText) {\n\n  if (profileText.includes(requiredSkill)) {\n    return 1;\n  }\n\n  const group = getGroup(requiredSkill);\n\n  if (group) {\n    for (const relatedSkill of group) {\n      if (profileText.includes(relatedSkill)) {\n        return 0.6;\n      }\n    }\n  }\n\n  return 0;\n}\n\n// --------------------------------------------------\n// SCORE EACH JOB\n// --------------------------------------------------\n\nreturn jobs.map(item => {\n\n  const job = item.json;\n\n  const title = normalize(job.title);\n  const requirements = normalize(job.requirements);\n  const description = normalize(job.description);\n\n  const jobText = [\n    title,\n    requirements,\n    description\n  ].join(' ');\n\n  // -----------------------------------------------\n  // 1. TECHNICAL SKILLS — 50%\n  // -----------------------------------------------\n\n  const skillWords = [\n    'javascript',\n    'typescript',\n    'react',\n    'next.js',\n    'node.js',\n    'express.js',\n    'python',\n    'java',\n    'c++',\n    'html',\n    'css',\n    'mongodb',\n    'sql',\n    'mysql',\n    'postgresql',\n    'redis',\n    'docker',\n    'azure',\n    'aws',\n    'git',\n    'github',\n    'rest api',\n    'machine learning',\n    'data science',\n    'figma',\n    'angular',\n    'vue.js'\n  ];\n\n  const detectedSkills = skillWords.filter(skill =>\n    jobText.includes(skill)\n  );\n\n  let technicalScore = 0;\n\n  if (detectedSkills.length > 0) {\n\n    let total = 0;\n\n    for (const skill of detectedSkills) {\n      total += skillMatch(skill, profileSkills);\n    }\n\n    technicalScore =\n      (total / detectedSkills.length) * 50;\n  }\n\n  // -----------------------------------------------\n  // 2. ROLE MATCH — 30%\n  // -----------------------------------------------\n\n  let roleScore = 0;\n\n  const roleGroups = [\n    ['software engineer', 'software engineering', 'software developer'],\n    ['frontend', 'front-end', 'frontend developer', 'react developer'],\n    ['backend', 'back-end', 'backend developer', 'node.js developer'],\n    ['full stack', 'full-stack', 'full stack developer'],\n    ['web developer', 'web development'],\n    ['devops', 'cloud engineer'],\n    ['data analyst', 'data science', 'machine learning'],\n    ['qa', 'quality assurance', 'software testing'],\n    ['ui ux', 'ui/ux', 'ui designer', 'ux designer']\n  ];\n\n  for (const group of roleGroups) {\n\n    const jobHasRole = group.some(role =>\n      title.includes(role)\n    );\n\n    const profileHasRole = group.some(role =>\n      profileRoles.includes(role)\n    );\n\n    if (jobHasRole && profileHasRole) {\n      roleScore = 30;\n      break;\n    }\n\n    // Partial related-role match\n    if (jobHasRole) {\n      const profileSkillRelated = group.some(role =>\n        profileSkills.includes(role)\n      );\n\n      if (profileSkillRelated) {\n        roleScore = 18;\n        break;\n      }\n    }\n  }\n\n  // -----------------------------------------------\n  // 3. INTERNSHIP FIT — 10%\n  // -----------------------------------------------\n\n  let internshipScore = 0;\n\n  const internshipWords = [\n    'intern',\n    'internship',\n    'trainee',\n    'undergraduate',\n    'student'\n  ];\n\n  if (internshipWords.some(word => title.includes(word))) {\n    internshipScore = 10;\n  }\n\n  // -----------------------------------------------\n  // 4. EDUCATION / EXPERIENCE FIT — 10%\n  // -----------------------------------------------\n\n  let educationScore = 0;\n\n  const educationKeywords = [\n    'computer engineering',\n    'computer science',\n    'software engineering',\n    'information technology',\n    'engineering',\n    'undergraduate',\n    'bachelor'\n  ];\n\n  const hasEducationMatch =\n    educationKeywords.some(keyword =>\n      jobText.includes(keyword) &&\n      profileEducation.includes(keyword)\n    );\n\n  if (hasEducationMatch) {\n    educationScore = 10;\n  } else if (\n    jobText.includes('undergraduate') &&\n    profileEducation.includes('undergraduate')\n  ) {\n    educationScore = 7;\n  } else {\n    educationScore = 4;\n  }\n\n  // -----------------------------------------------\n  // FINAL SCORE\n  // -----------------------------------------------\n\n  let score =\n    technicalScore +\n    roleScore +\n    internshipScore +\n    educationScore;\n\n  score = Math.round(Math.min(score, 100));\n\n  return {\n    json: {\n      ...job,\n      match_score: score\n    }\n  };\n});"
      },
